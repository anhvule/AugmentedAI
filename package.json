{
  "name": "deem",
  "version": "0.1.0",
  "private": true,
  "description": "Deem — desktop-first AI engineering. Describe a task in plain English; an AI agent plans, implements, reviews, tests and reports with consistent quality.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "app": "npm run build && electron electron/main.cjs",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@nx/devkit": "23.0.2",
    "@nx/eslint": "^23.0.2",
    "@nx/js": "^23.0.2",
    "@nx/node": "^23.0.2",
    "@nx/playwright": "^23.0.2",
    "@nx/react": "^23.0.2",
    "@nx/vite": "^23.0.2",
    "@nx/web": "23.0.2",
    "@playwright/test": "^1.37.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.1.0",
    "jiti": "2.4.2",
    "nx": "23.0.2",
    "prettier": "~3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "typescript": "~5.7.0",
    "vite": "^5.4.11"
  },
  "nx": {}
}
